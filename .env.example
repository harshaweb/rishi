# Copy to .env in the repository root. Keep credentials private.
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@YOUR-CLUSTER.mongodb.net/omshivraj?retryWrites=true&w=majority
SESSION_SECRET=replace-with-a-random-secret-of-at-least-32-characters
SITE_URL=http://localhost:5173
NODE_ENV=development
PORT=3001
# Optional services. Required for their corresponding production features.
RESEND_API_KEY=
EMAIL_FROM=
# Phone OTP login uses Twilio Programmable Messaging. Leave unset locally to use the development-only OTP shown on screen.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
MAPBOX_PUBLIC_TOKEN=
# Enable required DigiLocker account verification only after requester setup/testing.
DIGILOCKER_REQUIRED=0
DIGILOCKER_CLIENT_ID=
DIGILOCKER_CLIENT_SECRET=
# Bootstrap an admin with npm run rental:admin, then remove these values.
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
