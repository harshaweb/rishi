# Use npm run setup:local to generate ignored development-only credentials.
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/harshaweb
# Omshivraj rental bookings require PostgreSQL. Leave MONGODB_URL unset.
# MongoDB is supported only by the retained legacy business modules.
# When set, it takes precedence over DATABASE_URL and disables rental APIs.
# Replace USER/PASSWORD locally, URL-encode credentials, and include /harshaweb.
# MONGODB_URL=mongodb+srv://USER:PASSWORD@cluster0.xphpuau.mongodb.net/harshaweb?retryWrites=true&w=majority&appName=Cluster0
SESSION_SECRET=replace-with-at-least-32-cryptographically-random-characters
SITE_URL=http://localhost:5173
PORT=3001
NODE_ENV=development
LOCAL_POSTGRES=0
# Set to 1 only behind one trusted reverse proxy, with direct access blocked.
TRUST_PROXY=0
# Optional transactional email. Saving enquiries does not depend on this.
RESEND_API_KEY=
EMAIL_FROM=
ADMIN_NOTIFICATION_EMAIL=
# Production media uses a private S3-compatible bucket. Use workload credentials
# where possible. Never expose AWS variables through a VITE_ prefix.
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Optional consent-gated marketing identifiers. No tracking is loaded by default.
GA4_MEASUREMENT_ID=
GTM_CONTAINER_ID=
# Data retention must be decided by the operator. The CLI previews by default.
LEAD_RETENTION_DAYS=365
APPLICATION_RETENTION_DAYS=180
# Bootstrap password is supplied interactively, or via this process variable.
# Do not commit or keep bootstrap passwords in this example.

# Omshivraj rental marketplace requires PostgreSQL; leave MONGODB_URL unset.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
MAPBOX_PUBLIC_TOKEN=
# ADMIN_NAME, ADMIN_EMAIL, ADMIN_PASSWORD are transient rental:admin bootstrap inputs.
