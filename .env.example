# Use npm run setup:local to generate ignored development-only credentials.
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/harshaweb
SESSION_SECRET=replace-with-at-least-32-cryptographically-random-characters
SITE_URL=http://localhost:5173
PORT=3001
NODE_ENV=development
LOCAL_POSTGRES=0
# Set to 1 only behind one trusted reverse proxy, with direct access blocked.
TRUST_PROXY=0
# Optional transactional email. Saving enquiries does not depend on this.
RESEND_API_KEY=
EMAIL_FROM=
ADMIN_NOTIFICATION_EMAIL=
# Production media uses a private S3-compatible bucket. Use workload credentials
# where possible. Never expose AWS variables through a VITE_ prefix.
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Optional consent-gated marketing identifiers. No tracking is loaded by default.
GA4_MEASUREMENT_ID=
GTM_CONTAINER_ID=
# Data retention must be decided by the operator. The CLI previews by default.
LEAD_RETENTION_DAYS=365
APPLICATION_RETENTION_DAYS=180
# Bootstrap password is supplied interactively, or via this process variable.
# Do not commit or keep bootstrap passwords in this example.
