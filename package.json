{
  "name": "rishi",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "dev:client": "vite --host 127.0.0.1",
    "dev:server": "tsx watch server/index.ts",
    "build": "node scripts/check-source.mjs && tsc -b && tsc -p tsconfig.server.json && vite build && npm run build:server",
    "build:server": "esbuild server/http.ts --bundle --platform=node --format=esm --packages=external --jsx=automatic --outfile=dist-server/http.js",
    "build:vercel": "npm run db:generate && npm run build",
    "start": "node scripts/start.mjs",
    "setup:local": "tsx scripts/setup-local.ts",
    "db:migrate": "tsx scripts/database.ts deploy",
    "db:seed": "tsx prisma/seed.ts",
    "admin:create": "tsx scripts/create-admin.ts",
    "typecheck": "tsc -b && tsc -p tsconfig.server.json",
    "verify:connection": "tsx scripts/check-connection.ts",
    "production:check": "tsx scripts/check-production.ts",
    "test": "vitest run",
    "test:prepare": "tsx scripts/prepare-tests.ts",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "format": "prettier --write src shared server scripts tests prisma/seed.ts",
    "db:generate": "tsx scripts/database.ts generate",
    "admin:local": "tsx scripts/local-admin.ts",
    "retention": "tsx scripts/retention.ts",
    "test:production": "playwright test --config playwright.production.config.ts",
    "db:validate": "tsx scripts/database.ts validate",
    "rental:seed": "tsx scripts/seed-rentals.ts",
    "rental:admin": "tsx scripts/create-rental-admin.ts",
    "rental:catalog": "tsx scripts/rental-operations.ts catalog",
    "rental:expire": "tsx scripts/rental-operations.ts expire"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1149.0",
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@hookform/resolvers": "^5.9.1",
    "@prisma/client": "^6.19.3",
    "@tailwindcss/vite": "^4",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "connect-mongo": "^6.0.0",
    "connect-pg-simple": "^10.0.0",
    "dotenv": "^18.0.7",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "express-session": "^1.19.0",
    "file-type": "^22.1.1",
    "helmet": "^8.3.0",
    "lucide-react": "^1.55.0",
    "mongodb": "^7.7.0",
    "multer": "^2.4.0",
    "pg": "^8.23.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.89.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.4",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10",
    "@playwright/test": "^1.64.0",
    "@types/connect-pg-simple": "^7.0.3",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/multer": "^2.3.0",
    "@types/node": "^24",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^6",
    "concurrently": "^10.0.6",
    "embedded-postgres": "^18.4.0-beta.17",
    "esbuild": "^0.28.2",
    "eslint": "^10",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "prisma": "^6.19.3",
    "shadcn": "^4.21.4",
    "supertest": "^7.3.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8",
    "vite": "^8",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "deepmerge-ts": "8.0.2"
  }
}
